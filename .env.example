# Marginalia — environment template. Copy to .env (local) or use
# `wrangler secret put` (Cloudflare). NEVER commit real values.

# --- core -------------------------------------------------------------------
DEPLOYMENT_TARGET=local            # local | cloudflare
DJANGO_SECRET_KEY=change-me-please
ALLOWED_HOSTS=localhost,127.0.0.1
DEBUG=1                            # local only; ignored on cloudflare
TIME_ZONE=UTC
LOG_LEVEL=INFO

# --- local storage ----------------------------------------------------------
SQLITE_PATH=./db.sqlite3

# --- limits -----------------------------------------------------------------
MAX_PDF_SIZE_MB=200
MAX_PDF_PAGES=5000
ANNOTATION_OPS_PER_MINUTE=120
CHANGE_HORIZON_DAYS=30

# --- password hashing (Argon2id; tuned for Worker CPU budgets) --------------
ARGON2_TIME_COST=2
ARGON2_MEMORY_COST=19456
ARGON2_PARALLELISM=1

# --- cloudflare only (Worker secrets, names shown for reference) ------------
# DJANGO_SECRET_KEY=
# ALLOWED_HOSTS=library.example.com
# D1_BINDING=DB
# R2_BINDING=BUCKET
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_PUBLIC_HOST=

# --- maintenance ------------------------------------------------------------
TASKS_SECRET=change-me-too
MAINTENANCE_INTERVAL_S=3600

# --- optional features ------------------------------------------------------
FEATURE_REALTIME_PUSH=0            # SSE (local only), polling is the baseline
